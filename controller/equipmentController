const { equipmentTable, organizationTable } = require('../models');
const cloudinary = require('../middlewares/cloudinary');
const fs = require('fs');

exports.createEquipment = async (req, res) => {
  try {
    if (!req.files || req.files.length === 0) {
      return res.status(400).json({ message: "Images are required" });
    }

    const { organizationId } = req.params;

    const findOrganization = await organizationTable.findByPk(organizationId);
    if (!findOrganization) {
      return res.status(404).json({
        message: `Organization with ID: ${organizationId} not found`
      });
    }

    const allFilePaths = req.files.images;
    const filePaths = allFilePaths.map(file => file.path);
 
    const uploadResults = await Promise.all(
      filePaths.map(path => cloudinary.uploader.upload(path))
    );

    const secureUrls = uploadResults.map(e => e.secure_url);
    filePaths.forEach(file => {
      if (fs.existsSync(file.path)) {
        fs.unlinkSync(file.path);
      }
    });

    const { equipmentName, price, expirationDate, status } = req.body;

    const newEquipment = await equipmentTable.create({
      equipmentName,
      price,
      expirationDate: new Date(expirationDate),
      status,
      organizationId,
      images: JSON.stringify(secureUrls)
    });

    res.status(201).json({
      message: "Equipment created successfully",
      data: newEquipment
    });

  } catch (error) {
    console.log(error.message);
    res.status(500).json({
      message: "Something went wrong"
    });
  }}; 
  